# TicketPilot 本地研究工具；不需要平台账号密码或 API 密钥。
# 在 Playwright 打开的浏览器中人工登录。不要在这里填写 Cookie/Token。
# 默认有界面浏览器，需在有桌面的电脑运行后端。
TICKETPILOT_HEADLESS=false
# 留空使用 Playwright 安装的 Chromium。
# 仅本地/云端测试可指定已有浏览器，例如 /usr/bin/chromium。
TICKETPILOT_BROWSER_EXECUTABLE_PATH=
# 默认临时会话；true 允许本应用在 DATA_DIR 下按平台保存私有浏览器数据。
# 数据可能含敏感 Cookie/Token；不代表登录有效，不随发行包迁移到其他机器。
# 不填写账号密码，不导入个人 Chrome 或 TinyFish profile。
TICKETPILOT_PERSISTENT_BROWSER_SESSION=false
# 本地脱敏研究记录（SQLite）；该目录被 Git 忽略。
TICKETPILOT_DATA_DIR=data
# 单次初始导航超时（毫秒）；不自动重试或刷新平台。
TICKETPILOT_NAVIGATION_TIMEOUT_MS=45000
# 人工点击“记录当前页面”的最短间隔（秒）。
TICKETPILOT_CAPTURE_COOLDOWN_SECONDS=3
